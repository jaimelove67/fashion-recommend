# Generate .env.cloud with scripts/cloud-init-env.py; never commit the result.
# Defaults keep the application on server loopback for SSH-tunnel acceptance.
POSTGRES_DB=fashion_recommendation
POSTGRES_USER=fashion
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
MINIO_ROOT_USER=zhiji_storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=garments-private
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MAX_FILE_SIZE=10485760
BACKEND_PORT=8088
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8090
PUBLIC_ORIGIN=http://localhost:8090
AUTH_REGISTRATION_ENABLED=true
SESSION_TIMEOUT=30m
AI_SETTINGS_ENCRYPTION_KEY=
DASHSCOPE_API_KEY=
BAILIAN_ENABLED=true
BAILIAN_MODEL=qwen-plus
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_VISION_ENABLED=true
BAILIAN_VISION_MODEL=qwen-vl-plus
BAILIAN_IMAGE_ENABLED=true
BAILIAN_IMAGE_MODEL=wan2.6-image
BAILIAN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_IMAGE_TASK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/tasks
# Daily collection stays enabled; failures remain visible rather than using fake data.
TREND_CONFIGURED_DEMO_ENABLED=false
# Optional reviewed public Weibo import: disable the collector URL with an explicit empty value.
# TREND_WEIBO_URL=
# Use a separate server directory, mounted read-only in backend, to avoid collector overwrites.
# TREND_IMPORT_PATH=/opt/zhiji/shared/reviewed-trend-imports
WEATHER_CONFIGURED_DEMO_ENABLED=false
# Optional offline imports of the SAME pinned infrastructure images:
# CLOUD_POSTGRES_IMAGE=fashion-recommendation-cloud-postgres:16-3c5c8892d184
# CLOUD_MINIO_IMAGE=fashion-recommendation-cloud-minio:14cea493d9a3
# CLOUD_MC_IMAGE=fashion-recommendation-cloud-mc:a7fe349ef4bd
# Optional TLS overlay: use a real HTTPS origin and a server-only certificate folder.
# TLS_CERT_DIR=/etc/zhiji/tls
# FRONTEND_TLS_BIND_IP=0.0.0.0
# FRONTEND_TLS_PORT=443
