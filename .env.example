# Development-only defaults. Copy to .env and replace before any cloud deployment.
POSTGRES_DB=fashion_recommendation
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion_2404
POSTGRES_PORT=5433

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=fashion_minio_admin
MINIO_ROOT_PASSWORD=fashion_2404
MINIO_BUCKET=garments-private
MINIO_MAX_FILE_SIZE=10485760
MINIO_CLEANUP_INTERVAL=60s

# Docker application profile: docker compose --profile app up --build -d
BACKEND_PORT=8088
FRONTEND_PORT=8090
AUTH_REGISTRATION_ENABLED=true
SESSION_TIMEOUT=30m
# Local HTTP only. Set true for HTTPS deployment.
SESSION_COOKIE_SECURE=false
DASHSCOPE_API_KEY=
# Recommendation LLM is the primary engine. Set false only for offline tests/E2E to avoid paid calls.
BAILIAN_ENABLED=true
BAILIAN_MODEL=qwen-plus
BAILIAN_VISION_ENABLED=false
BAILIAN_VISION_MODEL=qwen-vl-plus
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_CONNECT_TIMEOUT=3s
BAILIAN_READ_TIMEOUT=8s
# Daily outfit visual: Wan 2.6 receives the exact prototype and available wardrobe photos as Base64.
BAILIAN_IMAGE_ENABLED=true
BAILIAN_IMAGE_MODEL=wan2.6-image
BAILIAN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_IMAGE_TASK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/tasks
BAILIAN_IMAGE_PROTOTYPE_MALE=classpath:reference_photo/model-male.png
BAILIAN_IMAGE_PROTOTYPE_FEMALE=classpath:reference_photo/model-female.png
BAILIAN_IMAGE_REFERENCE_BASE_URL=
BAILIAN_IMAGE_CONNECT_TIMEOUT=5s
BAILIAN_IMAGE_READ_TIMEOUT=15s
BAILIAN_IMAGE_TASK_TIMEOUT=90s
BAILIAN_IMAGE_POLL_INTERVAL=2s

# Real trends: publisher RSS + optional social feeds. Missing sources return empty, never demo rankings.
TREND_EDITORIAL_ENABLED=true
# Comma or newline separated HTTPS publisher feeds, fetched independently so one failing feed
# never removes another feed's items. Each feed is a real publication, not a social ranking.
TREND_EDITORIAL_FEEDS=https://www.vogue.com/feed/rss,https://hypebeast.cn/feed,https://www.toodaylab.com/feed
# Douyin and weibo additionally expose an anonymously readable public hot board: a ranked list of
# trending words with the platform's own heat value. It is consulted only when that platform has
# neither an import file nor an endpoint, so explicit data always wins. Boards carry no article
# body or image; keyword search and note content require a login and are never collected.
TREND_HOT_BOARDS_ENABLED=true
TREND_DOUYIN_URL=
TREND_XIAOHONGSHU_URL=
TREND_WEIBO_URL=
TREND_REFRESH_INTERVAL=21600000
# For local Java runs, point this at tools/trend-collector/data. Compose mounts it automatically.
# See docs/trend-collection.md for the export -> import -> review walkthrough.
TREND_IMPORT_DIRECTORY=
TREND_JSON_URL=
TREND_PLATFORM=configured-feed
# Optional comma-separated public HTML pages that the backend is authorized to read.
# The adapter extracts title/summary/tags/date/image from HTML metadata and JSON-LD.
TREND_WEB_URLS=
TREND_WEB_PLATFORM=web-scrape
TREND_WEB_MAX_PAGE_CHARS=1000000
TREND_WEB_MAX_ARTICLES_PER_PAGE=10
TREND_CONNECT_TIMEOUT=3s
TREND_READ_TIMEOUT=5s
TREND_CACHE_TTL=15m
# AI 初审默认开启；只进入人工终审队列，不会自动发布。离线测试/E2E 可关闭。
TREND_AI_REVIEW_ENABLED=true
TREND_AI_REVIEW_MODEL=qwen-plus
TREND_AI_REVIEW_CONNECT_TIMEOUT=3s
TREND_AI_REVIEW_READ_TIMEOUT=8s
TREND_AI_REVIEW_INITIAL_DELAY=30000
TREND_AI_REVIEW_INTERVAL=300000
TREND_AI_REVIEW_BATCH_SIZE=10

# Weather providers: wttr.in is primary and Open-Meteo is the fallback.
WEATHER_PRIMARY_BASE_URL=https://wttr.in
WEATHER_FALLBACK_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
WEATHER_FALLBACK_FORECAST_BASE_URL=https://api.open-meteo.com
WEATHER_CONNECT_TIMEOUT=3s
WEATHER_READ_TIMEOUT=3s
WEATHER_CACHE_TTL=15m
WEATHER_CACHE_MAX_SIZE=500

# 离线答辩演示（默认关闭）。仅当两个真实天气 provider 都失败且请求城市与 WEATHER_CONFIGURED_CITY
# 一致时，才返回静态快照（source=configured-demo，前端明确标注"配置演示天气/非实时"）。
# 这是静态演示数据，不是实时天气，绝不能冒充实时天气。启用时需填全以下所有字段。
WEATHER_CONFIGURED_DEMO_ENABLED=false
WEATHER_CONFIGURED_CITY=
WEATHER_CONFIGURED_TEMPERATURE_C=
WEATHER_CONFIGURED_APPARENT_TEMPERATURE_C=
WEATHER_CONFIGURED_PRECIPITATION_MM=
WEATHER_CONFIGURED_WEATHER_CODE=
WEATHER_CONFIGURED_WIND_SPEED_KMH=
